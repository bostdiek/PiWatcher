[Unit]
Description=PiWatcher Base Station
After=network-online.target docker.service piwatcher-inference.service
Wants=network-online.target docker.service piwatcher-inference.service

[Service]
Type=simple
User=bostdiek
WorkingDirectory=/home/bostdiek/Projects/PiWatcher
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/bostdiek/Projects/PiWatcher/.env
ExecStartPre=/usr/bin/docker compose up -d postgres
ExecStart=/home/bostdiek/.local/bin/uv run --package piwatcher-base piwatcher-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
