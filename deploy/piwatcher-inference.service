[Unit]
Description=PiWatcher Host Inference
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bostdiek
WorkingDirectory=/home/bostdiek/Projects/Personal/PiWatcher
Environment=LLAMA_SWAP_CONFIG=/home/bostdiek/Projects/Personal/PiWatcher/deploy/llama-swap/config.yaml
Environment=LLAMA_SWAP_LISTEN=127.0.0.1:8080
EnvironmentFile=-/home/bostdiek/Projects/Personal/PiWatcher/.env
ExecStart=/home/bostdiek/.local/bin/llama-swap --config ${LLAMA_SWAP_CONFIG} --listen ${LLAMA_SWAP_LISTEN}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
