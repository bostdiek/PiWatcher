# Copy this file to a private per-camera profile, for example:
#   deploy/cameras/roomtest.env
#
# Then deploy with:
#   make deploy-camera CAMERA_ENV_FILE=deploy/cameras/roomtest.env

CAMERA_HOST=pizero.local
CAMERA_USER=pizero
CAMERA_ID=roomtest
SERVER_URL=http://pi5.local:8000
WIFI_POWER_SAVE=false
ENABLE_CAMERA_SERVICE=true
START_CAMERA=true

# Optional capture tuning overrides:
# MOTION_THRESHOLD=7.0
# MIN_CHANGED_PCT=2.0
# CAPTURE_FPS=2.0
# CAPTURE_MIN_DURATION=10.0
# COOLDOWN_SECONDS=5.0
# HEARTBEAT_INTERVAL=900
# LORES_WIDTH=160
# LORES_HEIGHT=120
# MAIN_WIDTH=1024
# MAIN_HEIGHT=1024
# FRAME_QUEUE_DIR=/tmp/piwatcher/frames
# WIFI_STARTUP_GRACE_SECONDS=600
