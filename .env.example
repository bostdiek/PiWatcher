# PiWatcher Base Station Configuration
PIWATCHER_API_KEY=change-me-use-python-c-import-secrets-print-secrets-token-hex-32
DATABASE_URL=postgresql+asyncpg://piwatcher:piwatcher@localhost:5432/piwatcher
FRAME_STORAGE_PATH=./tmp/piwatcher/frames
ENABLE_INFERENCE=false
LLAMA_SWAP_URL=http://localhost:8080/v1
LLAMA_SWAP_MODEL=lfm2.5-vl-450m-q4_0
LLAMA_SWAP_IMAGE=ghcr.io/mostlygeek/llama-swap:unified-vulkan
LLAMA_SWAP_RUNTIME=host
LLAMA_SWAP_BIN=/home/bostdiek/.local/bin/llama-swap
LLAMA_SERVER_BIN=/home/bostdiek/Projects/llama.cpp/build/bin/llama-server
LLAMA_SWAP_LISTEN=127.0.0.1:8080
LLAMA_SWAP_MODELS_DIR=/mnt/nvme/piwatcher/models
LLAMA_SWAP_MODEL_FILE=LFM2.5-VL-450M-Q4_0.gguf
LLAMA_SWAP_MEDIA_PATH=/home/bostdiek/Downloads
# LLAMA_SWAP_MODEL_URL=
NTFY_TOPIC=piwatcher
NTFY_URL=https://ntfy.sh
MAX_INFERENCE_TEMP_C=72.0
COOLDOWN_TEMP_C=60.0
INFERENCE_GAP_SECONDS=15
HEARTBEAT_TTL_DAYS=90
